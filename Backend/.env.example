# ═══════════════════════════════════════════════════════════════════════════
# Lampose Main Backend — environment
#
# Copy to .env and fill in. Anything commented out has a working default;
# the uncommented ones should be set before a production deploy.
#
# One process serves three frontends:
#   lampose.com          → /api/v2/listings
#   leads.lampose.com    → /api/v2/{auth,users,scraper,properties}
#   onboard.lampose.com  → /api/v1/{properties,permissions,…} + /api/v2/auth
# ═══════════════════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=5001
# HOST=0.0.0.0

# ── Database ───────────────────────────────────────────────────────────────
# One database holds everything, split by collection:
#
#   properties, admins, verificationrequests, permissionrequests   v1
#   properties, scriper_users, scriper_jobs, scriper_leads         v2
#
# `properties` is shared by both surfaces on purpose: a listing onboarded
# through onboard.lampose.com is what lampose.com then shows.
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/lamp_onboarding?retryWrites=true&w=majority

# Overrides the database named in the URI. Rarely needed.
# DB_NAME=lamp_onboarding

# Storage for the leads data (users/jobs/leads) only:
#   auto  — MongoDB when a URI resolves, local JSON files otherwise (default)
#   mongo — MongoDB, and refuse to start without a URI
#   json  — always the files in data/. Never use in production: a container
#           filesystem is wiped on every deploy.
# SCRIPER_STORAGE=auto

# How long to wait for the cluster before falling back / retrying.
# DB_TIMEOUT_MS=8000
# DB_RETRY_MS=5000

# ── Secrets ────────────────────────────────────────────────────────────────
# Signs every /api/v2/auth login token, and the /api/v1/admin one. Must be
# long and random — 32 characters or more. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# Missing in production, the server still boots (the public site and the
# onboarding app must keep working) but /api/v2/auth and /api/v2/users answer
# 503 AUTH_NOT_CONFIGURED rather than issue a forgeable token.
JWT_SECRET=change_me_to_a_long_random_string
# JWT_EXPIRES_IN=7d

# Required to register an account with the ADMIN role via /api/v2/auth/register.
ADMIN_SECRET_KEY=change_me_too

# The v1 admin console's own registration key (/api/v1/admin/register), which
# is a DIFFERENT identity system from the one ADMIN_SECRET_KEY above guards.
# Falls back to the literal in routes/v1/adminRoutes.js when unset — and that
# literal is in the repo, so set this before anyone can reach the console.
# V1_ADMIN_SECRET_KEY=

# Guards /api/v2/users and the v2 property write routes. Every frontend
# already sends its bearer token, so leave this on unless a client cannot.
# REQUIRE_AUTH=true

# Creates the demo accounts (admin@scriper.com / admin123) when the user
# collection is empty. Keep false when MONGO_URI points at a real cluster.
SEED_DEFAULT_USERS=false

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated, *added* to the built-in list in config/env.js, which
# already covers lampose.com (+www), leads.lampose.com, onboard.lampose.com,
# api.lampose.com, localhost 3000/4173/5173/5174/5175/8004, and any
# *.lampose.com / *.vercel.app / *.netlify.app / *.onrender.com preview URL.
ALLOWED_ORIGINS=
# CORS_ORIGIN=              # alias, for the older leads deployment
# CORS_ALLOWED_ORIGINS=     # alias, for the older onboarding deployment
# CORS_ALLOW_ALL=false      # emergency switch; do not leave on in production

# ── Cloudinary (v1 image upload) ───────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Twilio / WhatsApp (v1 owner verification) ──────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Approved WhatsApp template sent to the property owner.
TWILIO_VERIFY_CONTENT_SID=
# Optional second template for the verification team. Falls back to the owner
# template when unset.
# TWILIO_TEAM_CONTENT_SID=
# Comma-separated whatsapp:+E164 numbers. When EMPTY, an owner's YES
# auto-verifies the property with no second pair of eyes — set this to put a
# verifier in the loop. (routes/v1/verificationRoutes.js)
# VERIFICATION_TEAM_NUMBERS=whatsapp:+919000000000,whatsapp:+919000000001
# Linked in the "your property is live" message sent after verification.
# PRODUCTION_WEBSITE_URL=https://lampose.com
VERIFICATION_TTL_HOURS=48
DEFAULT_PHONE_REGION=IN
ALLOW_UNSIGNED_WEBHOOKS=false
PUBLIC_BASE_URL=

# ── Twilio / WhatsApp (v2 visit availability) ──────────────────────────────
# A SEPARATE business flow from the verification block above, on the SAME
# Twilio number and the SAME webhook (/api/whatsapp/webhook). They are told
# apart by the word the owner replies with, never by the route:
#
#   YES / NO    → property verification   (v1, VerificationRequest)
#   AVAILABLE   → visit availability      (v2, VisitRequest)
#
# Both templates are OPTIONAL. Without them the messages are sent as plain
# text, which reaches an owner inside an open 24-hour WhatsApp session — good
# enough to test the flow before the templates clear Meta review, not good
# enough for production cold starts.
#
# Asks the owner whether a room is free. Variables:
#   {{1}} owner name  {{2}} property  {{3}} customer  {{4}} room  {{5}} when
#   {{6}} request id
# If it carries quick-reply buttons, set their payloads to
# VISIT_YES:{{6}} / VISIT_NO:{{6}} — the id is what picks the right request
# when an owner has several pending. The button TEXT should read AVAILABLE.
TWILIO_VISIT_REQUEST_CONTENT_SID=
# Tells the customer what the owner said. Variables:
#   {{1}} customer name  {{2}} property  {{3}} "available" | "not available"
TWILIO_VISIT_OUTCOME_CONTENT_SID=

# ── SMS one-time codes — smslogin.co, DLT registered ───────────────────────
# TWO flows send codes through this one gateway, on the same registered
# template, and both stop working if it is unconfigured:
#
#   /api/v2/visit-requests        proves a customer's number before an owner
#                                 is messaged on WhatsApp
#   /api/v2/customers/auth/start  signs a student into the mobile app
#
# The mobile app has no other way in — there are no passwords in it — so an
# unconfigured gateway here means nobody can sign in at all. The endpoints
# answer 503 SMS_NOT_CONFIGURED rather than failing further in.
# Codes do NOT go through Twilio. India binds SMS delivery to a registered
# sender header and an approved template body, and that registration is with
# smslogin.co; the Twilio sender above is a WhatsApp number.
SMS_API_URL=https://smslogin.co/v3/api.php
SMS_USERNAME=
SMS_APIKEY=
# The registered DLT header shown on the recipient's handset.
SMS_SENDERID=
# The DLT template id registered for the verification message.
SMS_OTP_TEMPLATE_ID=
# The DLT-approved body, character for character. Paste it exactly as the DLT
# portal shows it, INCLUDING the {#var#} slot — the code fills that in.
# KEEP THE QUOTES: a bare # starts a comment, so unquoted this value is
# silently truncated at "{" and the template loses its variable slot.
# Any validity period in the text must match OTP_TTL_MS in utils/otp.js.
OTP_SMS_TEMPLATE="Your Lampose OTP is {#var#}. Valid for 10 minutes. Please do not share it with anyone."
# Optional. Peppers the stored OTP hashes; falls back to TWILIO_AUTH_TOKEN,
# then JWT_SECRET, then a per-boot random value.
# OTP_PEPPER=

# ── Permissions (v1) ───────────────────────────────────────────────────────
# How long an administrator's edit/delete grant stays spendable.
# PERMISSION_GRANT_TTL_HOURS=24

# ── Scraper (v2) ───────────────────────────────────────────────────────────
# Playwright's Chromium must exist on the host:
#   npm run browsers
# Without it the API still runs and only /api/v2/scraper/start answers 503.
# SCRAPER_ENABLED=true
# SCRAPER_DEFAULT_DEPTH=15
# SCRAPER_MAX_DEPTH=100
# Pads short Google Maps results with generated rows. Off by default: the
# invented leads are indistinguishable from real ones once they are saved.
# SCRAPER_FILL_SHORT_RESULTS=false

# ── Logging & misc ─────────────────────────────────────────────────────────
# Every API call prints TWO lines: one when the request arrives (→) and one
# when the response leaves (←), joined by a short id shown as #a1b2. The
# arrival line is what distinguishes a request that hung or crashed from one
# that was never made — a single line on completion prints nothing for either.
#
# The id comes from the caller's X-Request-Id when it sends one, so the same
# id can be grepped in the client's console and in this one. Every Lampose
# frontend also names itself in X-Client, which is the only thing identifying
# the mobile apps: a React Native client sends no Origin header.
#
# Bodies — request and response alike — are redacted for password, token,
# secret, otp, hash and adminCode fields, and base64 images are shown as a
# size rather than printed.
# REQUEST_LOGGING=true
# REQUEST_LOG_BODY=true
# REQUEST_LOG_BODY_CHARS=500
# The response payload on the ← line. On by default: "what did the app
# actually receive" is the question this console is usually opened to answer.
# REQUEST_LOG_RESPONSE=true
# REQUEST_LOG_RESPONSE_CHARS=900
# TRUST_PROXY=true          # required behind Nginx / Render / Railway
# 25mb, not 1mb: the onboarding app posts base64 images in the JSON body.
# BODY_LIMIT=25mb
