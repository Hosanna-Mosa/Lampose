{
  "name": "lampose-main-backend",
  "version": "2.0.0",
  "description": "Unified Lampose backend — onboarding (v1) and the public site + leads panel (v2)",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node scripts/dev.js",
    "dev:watch": "node --watch server.js",
    "seed:admins": "node seedAdmins.js",
    "inspect:collections": "node scripts/inspect-db.js",
    "inspect:db": "node scripts/inspect-db.js",
    "inspect:properties": "node scripts/inspect-properties.js",
    "review:snapshot": "node scripts/export-review-snapshot.js",
    "migrate:clean-db": "node scripts/migrate-to-clean-db.js",
    "reconcile:inventory": "node scripts/reconcile-inventory.js",
    "clone:db": "node scripts/clone-db.js",
    "seed:booking": "node scripts/seed-booking-dev.js",
    "seed:sunand": "node scripts/seed-sunand-properties.js",
    "partner:password": "node scripts/set-partner-password.js",
    "sms:test": "node scripts/send-test-sms.js",
    "verify:partner-login": "node scripts/verify-partner-login.js",
    "export:listings": "node scripts/export-listings.js",
    "export:listings:clean": "node scripts/export-listings.js --clean",
    "migrate:json": "node scripts/migrate-json-store.js",
    "migrate:channel": "node scripts/migrate-request-channel.js",
    "fix:owner-email-index": "node scripts/fix-owner-email-index.js",
    "smoke": "node scripts/smoke-test.js",
    "verify": "node scripts/verify-frontends.js",
    "test": "NODE_ENV=test node --test \"tests/**/*.test.js\"",
    "test:watch": "NODE_ENV=test node --test --watch \"tests/**/*.test.js\"",
    "browsers": "playwright install --with-deps chromium",
    "migrate:categories": "node scripts/migrate-categories.js",
    "verify:food-partner": "node scripts/verify-food-partner.js",
    "verify:restaurant-admin": "node scripts/verify-restaurant-admin.js",
    "twilio:order-template": "node scripts/create-food-order-template.js",
    "twilio:delivery-template": "node scripts/create-delivery-request-template.js",
    "twilio:restaurant-template": "node scripts/create-restaurant-approved-template.js",
    "verify:order-whatsapp": "node scripts/verify-food-order-whatsapp.js",
    "seed:food-menu": "node scripts/seed-food-menu.js",
    "seed:food-restaurants": "node scripts/seed-food-restaurants.js",
    "backfill:food-covers": "node scripts/backfill-food-covers.js",
    "verify:food-order": "node scripts/verify-food-order-loop.js",
    "verify:food-dispatch": "node scripts/verify-food-dispatch.js",
    "verify:driver-onboarding": "node scripts/verify-driver-onboarding.js",
    "verify:hotel-payout": "node scripts/verify-hotel-payout.js",
    "verify:addresses": "node scripts/verify-addresses.js",
    "verify:support": "node scripts/verify-support.js",
    "verify:access": "node scripts/verify-access.js",
    "verify:food-favourites": "node scripts/verify-food-favourites.js",
    "check:schema": "node scripts/check-schema-coverage.js",
    "export:analytics": "node scripts/export-analytics.js"
  },
  "keywords": [
    "express",
    "mongodb",
    "mongoose",
    "lampose",
    "onboarding",
    "leads"
  ],
  "dependencies": {
    "@google-analytics/data": "^7.0.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.4.1",
    "multer": "^2.2.0",
    "playwright": "^1.62.1",
    "socket.io": "^4.8.1",
    "twilio": "^6.1.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0"
  }
}
