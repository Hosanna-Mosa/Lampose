# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
ios/
android/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo
.vercel

.env
.env.*

# Google Analytics / Google Cloud service-account keys — never commit these.
# Covers a key placed anywhere in the backend (config/, the repo root, etc.)
# regardless of the exact filename it was downloaded as.
*service-account*.json
*service_account*.json
lampose-analytics*.json
config/*.json

# Backups written by scripts/delete-user-data.js before it deletes anything.
# These are a full JSON copy of one person's name, phone, email and addresses —
# exactly the data the script was run to remove. Never commit them.
.deleted/
