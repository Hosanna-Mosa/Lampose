{
  "expo": {
    "name": "Lampose Stay Partner",
    "slug": "lampose-stay-partner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.jpeg",
    "scheme": "lamposepartner",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/lampose-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#14492F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lampose.staypartner"
    },
    "android": {
      "permissions": [
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "package": "com.lampose.staypartner.com"
    },
    "web": {
      "favicon": "./assets/images/icon.jpeg"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.jpeg",
          "color": "#14492F",
          "defaultChannel": "stay-requests"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "fad3ed39-5253-4f81-9a9f-d5502b2a03de"
      }
    },
    "owner": "hosanna4190"
  }
}
