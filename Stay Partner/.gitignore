# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
ios/
# android/ is TRACKED — the native project is committed so a release build
# is reproducible without `expo prebuild`. Signing material is not: *.jks
# below keeps the upload key out, and its passwords live in
# ~/.gradle/gradle.properties, never in android/gradle.properties.
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo
.vercel

.env


# Firebase, per environment. Download it from the console rather than
# sharing one — a committed file is the wrong project on somebody else's
# machine, and it is regenerated whenever an app is re-registered.
google-services.json
GoogleService-Info.plist