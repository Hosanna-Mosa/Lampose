# Every value this app reads. Copy to `.env` and restart the bundler with
# `npm start -c` — EXPO_PUBLIC_* variables are inlined at build time, so a
# reload alone will not pick up a change.
#
# Nothing secret belongs in here. EXPO_PUBLIC_* values are compiled into the
# bundle and are readable by anybody holding the APK.

# The backend origin. No trailing slash, no /api suffix. REQUIRED — this app
# has no fallback and will not guess: an owner's app pointed at the wrong host
# would show an empty account rather than an error.
#
# A phone cannot reach `localhost` — that is the phone itself. Use the LAN
# address of the machine running the backend.
#
#   local device : http://192.168.1.3:5001
#   production   : https://total.lampose.com
EXPO_PUBLIC_API_URL=

# ── How this reaches a CLOUD build ───────────────────────────────────────
# This file is git-ignored, and EAS uploads the project by the same rules — so
# a build on Expo's servers never sees it. That is not a theory: an APK was
# shipped with no API URL at all because this was the only place it existed,
# and every request in it went nowhere.
#
# So set the same value as an EAS environment variable, which lives on the
# Expo project rather than in the repo:
#
#   eas env:create --name EXPO_PUBLIC_API_URL \
#     --value https://total.lampose.com --environment production
#   eas env:create --name EXPO_PUBLIC_API_URL \
#     --value https://total.lampose.com --environment preview
#
# Check what a build will actually get with:  eas env:list
#
# This file stays the source for LOCAL work, where the URL is a LAN address
# that differs per machine and belongs to nobody else.

# Which build this is: development | preview | production.
#
# `production` silences the console. That matters here because the request log
# prints every URL with a preview of its body, and the screens log the body of
# any failure — an owner's bookings and payout details, going to a log nobody
# is reading.
#
# Unset is treated as `production` in a standalone build and `development`
# under Metro, so a build made without this file is the safe one. A misspelt
# value is treated the same way.
EXPO_PUBLIC_APP_ENV=development
