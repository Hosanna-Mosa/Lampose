# Vite bakes this in AT BUILD TIME — see deploy/VPS.md. A production bundle
# built with the dev value silently ships a console that calls
# http://localhost:8026 from every visitor's browser, which fails for
# everyone except whoever built it.
#
# `.env` stays pointed at the local backend for `npm run dev`; this file is
# what `npm run build` uses, because Vite loads `.env.production` in
# production mode. The two no longer have to be swapped by hand.
VITE_API_BASE_URL=https://total.lampose.com/api
