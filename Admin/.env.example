VITE_API_BASE_URL=http://localhost:5001/api

# Google Maps, for the Service Zones page's drawing map.
#
# Without it the page still lists, creates, edits, switches off and deletes
# zones — coordinates can be typed by hand — but you cannot draw by clicking.
# There is deliberately no fallback key in source: `server.js` states the rule
# this follows, that no credential is ever hardcoded here.
VITE_GOOGLE_MAPS_API_KEY=
