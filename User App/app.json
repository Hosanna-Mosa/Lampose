{
  "expo": {
    "name": "Lampose",
    "slug": "lampose",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.jpeg",
    "scheme": "lampose",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#0b1724"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lampose.user"
    },
    "android": {
      "permissions": [
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "package": "com.lampose.users.com"
    },
    "web": {
      "favicon": "./assets/images/icon.jpeg"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.jpeg",
          "color": "#0b1724",
          "defaultChannel": "stay-requests"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "f954b7a0-c4da-49d9-80e7-89262c052954"
      }
    },
    "owner": "hosanna4190"
  }
}
