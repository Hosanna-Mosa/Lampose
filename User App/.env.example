# Every value this app reads. Copy to `.env` and restart the bundler with
# `npm start -c` — EXPO_PUBLIC_* variables are inlined at build time, so a
# reload alone will not pick up a change.
#
# Nothing secret belongs in here. EXPO_PUBLIC_* values are compiled into the
# bundle and are readable by anybody holding the APK.

# The backend origin. No trailing slash, no /api suffix.
#
# A phone cannot reach `localhost` — that is the phone itself. Use the LAN
# address of the machine running the backend.
#
#   local device : http://192.168.1.3:5001
#   production   : https://total.lampose.com
#
# Leave it unset in development and the app guesses the Metro host, which is
# usually right. `API_BASE_URL_IS_GUESSED` reports when it did.
EXPO_PUBLIC_API_URL=

# Which build this is: development | preview | production.
#
# This is the switch that hides the internal tooling. Several screens carry
# preview controls — rows of buttons that jump a booking between its thirteen
# statuses, or force a request to accepted, rejected or expired — and the Food
# tab can open an in-progress module. `production` hides all of it.
#
#   development : Metro on your machine. Everything visible.
#   preview     : an internal APK — a real standalone build, still with the
#                 controls, for testing push on a handset.
#   production  : the build that goes to students. Controls gone, console
#                 silent, Food forced to "coming soon" whatever the line below
#                 says.
#
# Unset is treated as `production` in a standalone build and `development`
# under Metro, so a build made without this file is the safe one. A misspelt
# value is treated the same way — a typo must never be what puts an internal
# tool in front of a student.
EXPO_PUBLIC_APP_ENV=development

# Which Food module the tab opens: `dev` for the in-progress UI, anything
# else — including unset — for the "coming soon" screen.
EXPO_PUBLIC_FOOD_MODE=production
