# Copy to .env and fill in. `.env` is gitignored; this file is the record.
#
# Every client-visible variable must carry the EXPO_PUBLIC_ prefix or Expo
# strips it from the bundle. Values are inlined at build time — restart the
# dev server (npm start -c) after changing them; a reload is not enough.

# What the Food tab opens.
#   production  -> "coming soon" screen (the default, and the fallback for a
#                  missing or misspelt value — a typo must never ship the
#                  unfinished module)
#   dev         -> the in-progress Food UI, for building it behind the tab
EXPO_PUBLIC_FOOD_MODE=production
