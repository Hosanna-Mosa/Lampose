# Every value this app reads. Copy to `.env` and restart the bundler with
# `npm start -c` — EXPO_PUBLIC_* variables are inlined at build time, so a
# reload alone will not pick up a change.
#
# Nothing secret belongs in here. EXPO_PUBLIC_* values are compiled into the
# bundle and are readable by anybody holding the APK.

# The backend origin. No trailing slash, no /api suffix.
#
# A phone cannot reach `localhost` — that is the phone itself. Use the LAN
# address of the machine running the backend.
#
#   local device : http://192.168.1.3:5001
#   production   : https://total.lampose.com
#
# Leave it unset in development and the app guesses the Metro host, which is
# usually right. `API_BASE_URL_IS_GUESSED` reports when it did.
EXPO_PUBLIC_API_URL=

# ── How this reaches a CLOUD build ───────────────────────────────────────
# This file is git-ignored, and EAS uploads the project by the same rules — so
# a build on Expo's servers never sees it. That is not a theory: an APK was
# shipped with no API URL at all because this was the only place it existed,
# and every request in it went nowhere.
#
# So set the same value as an EAS environment variable, which lives on the
# Expo project rather than in the repo:
#
#   eas env:create --name EXPO_PUBLIC_API_URL \
#     --value https://total.lampose.com --environment production
#   eas env:create --name EXPO_PUBLIC_API_URL \
#     --value https://total.lampose.com --environment preview
#
# Check what a build will actually get with:  eas env:list
#
# This file stays the source for LOCAL work, where the URL is a LAN address
# that differs per machine and belongs to nobody else.

# Which build this is: development | preview | production.
#
# This is the switch that hides the internal tooling. Several screens carry
# preview controls — rows of buttons that jump a booking between its thirteen
# statuses, or force a request to accepted, rejected or expired — and the Food
# tab can open an in-progress module. `production` hides all of it.
#
#   development : Metro on your machine. Everything visible.
#   preview     : an internal APK — a real standalone build, still with the
#                 controls, for testing push on a handset.
#   production  : the build that goes to students. Controls gone, console
#                 silent, Food forced to "coming soon" whatever the line below
#                 says.
#
# Unset is treated as `production` in a standalone build and `development`
# under Metro, so a build made without this file is the safe one. A misspelt
# value is treated the same way — a typo must never be what puts an internal
# tool in front of a student.
EXPO_PUBLIC_APP_ENV=development

# Which Food module the tab opens: `dev` for the in-progress UI, anything
# else — including unset — for the "coming soon" screen.
# Where the backend is. Usually not needed: services/api/config.ts guesses
# it from the address Metro served the JS bundle from, on the backend's
# documented default port (5001). Set this explicitly when that guess is
# wrong — most commonly because Backend/.env overrides PORT to something
# else, which it has on this repo's local setup more than once (8020, then
# 8026 — check Backend/.env's current PORT, or the "listening on port ####"
# line the backend prints on startup, rather than trusting a number written
# down here). A device on a tunnel or a different network than the dev
# machine also needs this set by hand, since there is no LAN address to
# guess from in that case.
#   EXPO_PUBLIC_API_URL=http://<dev-machine-lan-ip>:<backend-port>

# What the Food tab opens.
#   production  -> "coming soon" screen (the default, and the fallback for a
#                  missing or misspelt value — a typo must never ship the
#                  unfinished module)
#   dev         -> the in-progress Food UI, for building it behind the tab
EXPO_PUBLIC_FOOD_MODE=production
