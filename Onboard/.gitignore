# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
ios/
android/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# ── Environment and secrets ──────────────────────────────────────────────
# Commit .env.example instead, so the required keys are documented without
# their values. This also covers .env.production, so a real key never lands
# in a committed, un-ignored file here.
.env
.env.*
.env.production
!.env.example

# typescript
*.tsbuildinfo
.vercel
