# ══════════════════════════════════════════════════════════════════════════
# Lampose Onboard — environment
#
# The API root, and the only URL this app reads. It is the root ending in
# /api, NOT a single endpoint: services/api.js derives /properties,
# /permissions, /auth and the upload routes from it, so this one line
# repoints the whole site.
#
#   production   VITE_API_BASE_URL=https://api.lampose.com/api
#   local        VITE_API_BASE_URL=http://localhost:5001/api
#
# Whatever host you point this at must have this site's origin listed in
# ALLOWED_ORIGINS at the top of Backend/server.js, or the browser blocks
# every call before the server ever sees it.
#
# The older VITE_API_URL (which pointed at .../api/properties) is still read
# as a fallback and normalised, so an existing deployment keeps working — but
# set VITE_API_BASE_URL going forward.
# ══════════════════════════════════════════════════════════════════════════
VITE_API_BASE_URL=http://localhost:5001/api
