# Driver — environment variables
# Copy to `.env` and fill in your own values. `.env` is gitignored.

# Where auth comes from:
#   mock  - fake sign in / sign up, no backend required (see utils/mockAuth.ts)
#   api   - the real endpoints below
# Unset falls back to mock when EXPO_PUBLIC_API_URL is empty.
EXPO_PUBLIC_AUTH_MODE=mock

# Backend API base URL. No trailing slash, no /api/v1 suffix —
# the app appends the versioned paths itself.
EXPO_PUBLIC_API_URL=http://localhost:5000

# Google Maps SDK key. Required for the map to render on Android and iOS.
# For EAS builds, store it as a secret instead of committing it:
#   eas secret:create --name EXPO_PUBLIC_GOOGLE_MAPS_API_KEY --value <your-key>
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Identity verification provider (used by /api/v1/onboarding/verify-*).
EXPO_PUBLIC_IDENTITY_PROVIDER_ID=

# Payments provider key, if you enable in-app payouts.
EXPO_PUBLIC_PAYMENTS_KEY_ID=
