# Driver — environment variables
# Copy to `.env` and fill in your own values. `.env` is gitignored.

# Backend API base URL. No trailing slash and no version suffix — the app
# appends `/api/v2/drivers/...` itself. The socket connects to the same origin.
#
# There is no mock mode any more. Sign-in is a real phone number and a real
# six-digit code from `POST /api/v2/drivers/auth/start` — and that code is a
# REAL SMS in development too. `infrastructure/sms/sms.js` calls the live
# gateway whatever NODE_ENV says, so sign in with a number you own: an invented
# ten-digit Indian mobile number belongs to somebody, and they get the text.
EXPO_PUBLIC_API_URL=http://localhost:5001

# Google Maps, for the active-job map (`components/ui/MapPanel.tsx`).
#
# Baked into the native binary by `app.config.js`, not read at JS runtime — a
# fresh `eas build` / `expo prebuild` is needed after this changes, and a
# reload alone will not pick it up. Unset leaves the native map view with no
# imagery to draw; the distance readout and everything else on the screen
# still works.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
